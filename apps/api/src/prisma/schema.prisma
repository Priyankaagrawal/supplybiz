generator client {
  provider = "prisma-client-js"
}

// T-180: ephemeral challenge, budget and lockout state; never plaintext PII/OTP.
model auth_abuse_state {
  key        String   @id @db.VarChar(100)
  value      Json
  expires_at DateTime @db.Timestamptz(6)

  @@index([expires_at])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum user_language {
  EN
  HI
}

enum user_status {
  ACTIVE
  BLOCKED
  DELETED
}

enum user_role_type {
  CUSTOMER
  VENDOR
}

enum consent_doc_type {
  TERMS
  PRIVACY
}

enum session_status {
  ACTIVE
  REVOKED
}

enum device_platform {
  ANDROID
  IOS
  WEB
}

enum admin_user_status {
  ACTIVE
  DISABLED
}

enum category_type {
  SUPPLY
  BILL
}

enum category_status {
  ENABLED
  COMING_SOON
  HIDDEN
}

enum plan_code {
  BASIC
  STANDARD
  BUSINESS
  PREMIUM
}

enum plan_price_duration {
  MONTHLY
  HALF_YEARLY
  YEARLY
}

enum plan_status {
  ACTIVE
  INACTIVE
}

enum outbox_event_status {
  PENDING
  DISPATCHED
  FAILED
}

model users {
  id          String          @id @default(uuid()) @db.Uuid
  mobile      String          @unique
  name        String?         @db.VarChar(120)
  email       String?         @db.VarChar(254)
  photo_media_id String?      @db.Uuid
  language    user_language   @default(EN)
  active_role user_role_type  @default(CUSTOMER)
  status      user_status     @default(ACTIVE)
  created_at  DateTime        @default(now()) @db.Timestamptz(6)
  updated_at  DateTime        @updatedAt @db.Timestamptz(6)

  roles       user_roles[]
  consents    consents[]
  sessions    sessions[]
  devices     devices[]
  media_uploads media_files[]
  vendor vendors?
  preferences user_preferences?
  stock_movements stock_movements[]
  notifications notifications[]
}

model user_roles {
  user_id     String         @db.Uuid
  role        user_role_type
  created_at  DateTime       @default(now()) @db.Timestamptz(6)

  user        users          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, role])
  @@index([role])
}

model consents {
  user_id      String         @db.Uuid
  doc_type     consent_doc_type
  doc_version  String         @db.VarChar(50)
  accepted_at  DateTime       @default(now()) @db.Timestamptz(6)
  ip           String?        @db.VarChar(64)

  user         users          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, doc_type, doc_version])
  @@index([user_id])
}

model sessions {
  id                 String         @id @default(uuid()) @db.Uuid
  user_id            String         @db.Uuid
  refresh_token_hash String         @db.VarChar(255)
  family_id          String         @db.Uuid
  device_id          String?        @db.Uuid
  expires_at         DateTime       @db.Timestamptz(6)
  revoked_at         DateTime?      @db.Timestamptz(6)
  last_used_at       DateTime?      @db.Timestamptz(6)
  status             session_status @default(ACTIVE)
  created_at         DateTime       @default(now()) @db.Timestamptz(6)

  user               users          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
}

model devices {
  notification_pushes notification_pushes[]
  id            String          @id @default(uuid()) @db.Uuid
  user_id       String          @db.Uuid
  platform      device_platform
  app_version   String?         @db.VarChar(64)
  os_version    String?         @db.VarChar(64)
  push_token    String?         @unique
  push_enabled  Boolean         @default(true)
  last_seen_at  DateTime?       @db.Timestamptz(6)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @updatedAt @db.Timestamptz(6)

  user          users           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model user_preferences {
  user_id             String   @id @db.Uuid
  notification_prefs  Json
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @updatedAt @db.Timestamptz(6)

  user                users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model admin_users {
  id               String            @id @default(uuid()) @db.Uuid
  email            String            @unique @db.VarChar(254)
  password_hash    String            @db.VarChar(255)
  totp_secret_enc  String?           @db.VarChar(512)
  failed_attempts  Int               @default(0)
  locked_until     DateTime?         @db.Timestamptz(6)
  last_totp_step   BigInt            @default(-1)
  role             String            @db.VarChar(64)
  status           admin_user_status @default(ACTIVE)
  last_login_at    DateTime?         @db.Timestamptz(6)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @updatedAt @db.Timestamptz(6)
  auth_challenges admin_auth_challenges[]
  auth_sessions admin_sessions[]
  auth_events admin_auth_events[]
  media_reads media_access_events[]
}

model categories {
  vendors vendors[]
  id            String          @id @default(uuid()) @db.Uuid
  code          String          @unique @db.VarChar(64)
  name_en       String          @db.VarChar(120)
  name_hi       String          @db.VarChar(120)
  icon          String?         @db.VarChar(120)
  type          category_type
  status        category_status @default(ENABLED)
  sort_order    Int             @default(0)
  product_types Json?
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @updatedAt @db.Timestamptz(6)
}

model plans {
  id             String       @id @default(uuid()) @db.Uuid
  code           plan_code    @unique
  name           String       @db.VarChar(120)
  customer_limit Int
  features       String[]
  is_popular     Boolean      @default(false)
  status         plan_status  @default(ACTIVE)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @updatedAt @db.Timestamptz(6)

  prices         plan_prices[]
}

model plan_prices {
  id               String              @id @default(uuid()) @db.Uuid
  plan_id          String              @db.Uuid
  duration         plan_price_duration
  price_paise      BigInt
  store_product_id String?             @db.VarChar(200)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime            @updatedAt @db.Timestamptz(6)

  plan             plans               @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([plan_id, duration])
  @@index([duration])
}

model idempotency_keys {
  idempotency_key String   @id @db.VarChar(120)
  user_id         String?  @db.Uuid
  method          String   @db.VarChar(10)
  path            String   @db.VarChar(255)
  request_hash    String   @db.VarChar(64)
  response_status Int
  response_body   Json
  expires_at      DateTime @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  @@index([expires_at])
}

model outbox_events {
  notification_push notification_pushes?
  id             String             @id @default(uuid()) @db.Uuid
  aggregate_type String             @db.VarChar(100)
  aggregate_id   String?            @db.Uuid
  event_type     String             @db.VarChar(120)
  payload        Json
  status         outbox_event_status @default(PENDING)
  attempt_count  Int                @default(0)
  available_at   DateTime           @default(now()) @db.Timestamptz(6)
  dispatched_at  DateTime?          @db.Timestamptz(6)
  last_error     String?            @db.VarChar(500)
  lease_token    String?            @db.Uuid
  lease_until    DateTime?          @db.Timestamptz(6)
  job_run        job_runs?
  created_at     DateTime           @default(now()) @db.Timestamptz(6)
  updated_at     DateTime           @updatedAt @db.Timestamptz(6)

  @@index([status, available_at])
}

model job_runs {
  id            String        @id @default(uuid()) @db.Uuid
  job_type      String        @db.VarChar(120)
  business_date DateTime      @db.Date
  scope_id      String        @db.VarChar(120)
  event_id      String        @unique @db.Uuid
  event         outbox_events @relation(fields: [event_id], references: [id])
  counts        Json          @default("{}")
  finished_at   DateTime?     @db.Timestamptz(6)

  @@unique([job_type, business_date, scope_id])
}

// T-017: public allowlisted mobile policy; admin editing is owned by T-158.
model app_config {
  key        String   @id @db.VarChar(100)
  value      Json
  updated_at DateTime @updatedAt @db.Timestamptz(6)
}

// T-150: only hashes of bearer credentials are persisted; challenges expire in 5m.
model admin_auth_challenges {
  token_hash String @id @db.VarChar(64)
  admin_id String @db.Uuid
  secret_enc String @db.VarChar(512)
  enrolling Boolean
  expires_at DateTime @db.Timestamptz(6)
  admin admin_users @relation(fields: [admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
model admin_sessions {
  token_hash String @id @db.VarChar(64)
  admin_id String @db.Uuid
  csrf_hash String @db.VarChar(64)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  last_used_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)
  @@index([admin_id])
  @@index([expires_at])
  admin admin_users @relation(fields: [admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
// Auth-only events; the general audit module/viewer belongs to T-152.
model admin_auth_events {
  id String @id @default(uuid()) @db.Uuid
  admin_id String? @db.Uuid
  action String @db.VarChar(64)
  at DateTime @default(now()) @db.Timestamptz(6)
  admin admin_users? @relation(fields: [admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// T-020: immutable validated uploads; resource attachment remains in owning modules.
model media_files {
  id                   String   @id @db.Uuid
  owner_user_id        String   @db.Uuid
  purpose              String   @db.VarChar(24)
  relative_storage_key String   @unique @db.VarChar(100)
  mime                 String   @db.VarChar(40)
  size                 Int
  sha256               String   @db.Char(64)
  status               String   @default("READY") @db.VarChar(16)
  request_key          String   @db.Char(64)
  request_hash         String   @db.Char(64)
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  owner users @relation(fields: [owner_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  access_events media_access_events[]
  shops vendors[]
  products products[]

  @@unique([owner_user_id, request_key])
  @@index([owner_user_id, created_at])
}

model media_access_events {
  id            String   @id @default(uuid()) @db.Uuid
  media_id      String   @db.Uuid
  admin_user_id String   @db.Uuid
  action        String   @default("KYC_DOCUMENT_READ") @db.VarChar(32)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  media media_files @relation(fields: [media_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  admin admin_users @relation(fields: [admin_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([media_id, created_at])
}

// T-021: nullable business fields represent a category-only onboarding draft.
model vendors {
  id String @id @default(uuid()) @db.Uuid
  user_id String @unique @db.Uuid
  category_id String @db.Uuid
  business_name String? @db.VarChar(80)
  gstin String? @db.VarChar(15)
  address_line String? @db.VarChar(200)
  city String? @db.VarChar(120)
  state String? @db.VarChar(120)
  pincode String? @db.VarChar(6)
  latitude Float?
  longitude Float?
  location Unsupported("geography(Point,4326)")? @default(dbgenerated())
  shop_photo_media_id String? @db.Uuid
  onboarding_step Int @default(2)
  kyc_status String @default("NOT_VERIFIED") @db.VarChar(24)
  is_suspended Boolean @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)
  category categories @relation(fields: [category_id], references: [id], onDelete: Restrict)
  shop_photo media_files? @relation(fields: [shop_photo_media_id], references: [id], onDelete: Restrict)
  settings vendor_settings?
  service_pincodes vendor_service_pincodes[]
  products products[]
}

// T-026: catalog foundation. Money and quantities are integral.
model products {
  id String @id @default(uuid()) @db.Uuid
  vendor_id String @db.Uuid
  name String @db.VarChar(120)
  product_type String @db.VarChar(80)
  milk_type String? @db.VarChar(24)
  unit_value Decimal @db.Decimal(12, 3)
  unit_type String @db.VarChar(3)
  selling_price_paise Int
  subscription_price_paise Int?
  stock_qty Int @default(0)
  moq Int @default(1)
  description String @default("") @db.VarChar(500)
  image_media_id String? @db.Uuid
  is_active Boolean @default(true)
  deleted_at DateTime? @db.Timestamptz(6)
  version Int @default(1)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  vendor vendors @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  image media_files? @relation(fields: [image_media_id], references: [id], onDelete: Restrict)
  movements stock_movements[]
  subscription_links product_subscription_links[]
  @@index([vendor_id, is_active])
}

model stock_movements {
  id String @id @default(uuid()) @db.Uuid
  product_id String @db.Uuid
  delta Int
  reason String @db.VarChar(16)
  note String @db.VarChar(200)
  ref_id String? @db.Uuid
  created_by String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  product products @relation(fields: [product_id], references: [id], onDelete: Restrict)
  creator users @relation(fields: [created_by], references: [id], onDelete: Restrict)
  @@index([product_id, created_at])
}

// T-072 must maintain this deletion guard in the subscription transaction.
model product_subscription_links {
  subscription_id String @id @db.Uuid
  product_id String @db.Uuid
  status String @db.VarChar(24)
  product products @relation(fields: [product_id], references: [id], onDelete: Restrict)
  @@index([product_id, status])
}

model vendor_service_pincodes {
  vendor_id String @db.Uuid
  pincode String @db.VarChar(6)
  vendor vendors @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  @@id([vendor_id, pincode])
}

// Unconfigured operational values stay null until their owning task saves them.
model vendor_settings {
  vendor_id String @id @db.Uuid
  service_radius_km Int? @default(3)
  delivery_charge_paise Int @default(0)
  min_order_paise Int @default(0)
  time_slots Json @default("[]")
  same_day_cutoff DateTime? @db.Time(0)
  auto_accept_subscriptions Boolean @default(false)
  accepting_today Boolean @default(false)
  delivery_paused Boolean @default(false)
  delivery_paused_until DateTime? @db.Timestamptz(6)
  max_daily_orders Int?
  daily_milk_capacity_ml Int?
  low_stock_threshold Int @default(10)
  allow_khata_orders Boolean @default(false)
  version Int @default(1)
  vendor vendors @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
}

// T-152: append-only, PII-redacted business audit; retention remains Q-20.
model audit_logs {
  id String @id @default(uuid()) @db.Uuid
  actor_type String @db.VarChar(16)
  actor_id String? @db.Uuid
  action String @db.VarChar(64)
  entity String @db.VarChar(64)
  entity_id String? @db.Uuid
  before Json?
  after Json?
  ip String? @db.VarChar(45)
  at DateTime @default(now()) @db.Timestamptz(6)
  @@index([at, id])
}

// T-022: revisions preserve manual review evidence; no provider checks claimed.
model vendor_kyc {
  id String @id @default(uuid()) @db.Uuid
  vendor_id String @db.Uuid
  status String @default("MANUAL_REVIEW") @db.VarChar(24)
  verification_method String @default("MANUAL_REVIEW") @db.VarChar(24)
  provider_checks String @default("NOT_RUN") @db.VarChar(16)
  aadhaar_front_media_id String @db.Uuid
  aadhaar_back_media_id String @db.Uuid
  pan_media_id String @db.Uuid
  pan_enc String
  pan_last4 String @db.VarChar(4)
  account_number_enc String
  account_last4 String @db.VarChar(4)
  holder_name String @db.VarChar(120)
  bank_name String @db.VarChar(120)
  ifsc String @db.VarChar(11)
  upi_id String? @db.VarChar(321)
  submitted_at DateTime @default(now()) @db.Timestamptz(6)
  reviewed_at DateTime? @db.Timestamptz(6)
  reviewer_id String? @db.Uuid
  reason String? @db.VarChar(500)
  @@index([vendor_id, submitted_at])
  @@index([status, submitted_at, id])
}

// Durable in-app KYC notices; push delivery is owned by T-032.
model kyc_notices {
  id String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid
  submission_id String @unique @db.Uuid
  status String @db.VarChar(24)
  reason String? @db.VarChar(500)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  @@index([user_id, created_at])
}

// T-032: role-scoped operational inbox. Text/data contain no KYC/bank details.
model notifications {
  id String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid
  role user_role_type
  category String @db.VarChar(16)
  type String @db.VarChar(40)
  source_key String @unique @db.VarChar(120)
  title String @db.VarChar(120)
  body String @db.VarChar(300)
  data Json
  mandatory Boolean @default(false)
  read_at DateTime? @db.Timestamptz(6)
  cleared_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)
  pushes notification_pushes[]
  @@index([user_id, role, created_at, id])
  @@index([created_at])
}

model notification_pushes {
  id String @id @default(uuid()) @db.Uuid
  notification_id String @db.Uuid
  device_id String @db.Uuid
  token_hash String @db.Char(64)
  status String @default("PENDING") @db.VarChar(16)
  event_id String @unique @db.Uuid
  sent_at DateTime? @db.Timestamptz(6)
  notification notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  device devices @relation(fields: [device_id], references: [id], onDelete: Restrict)
  event outbox_events @relation(fields: [event_id], references: [id], onDelete: Restrict)
  @@unique([notification_id, device_id])
}
