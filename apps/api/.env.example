NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://supplybiz:supplybiz@localhost:5432/supplybiz
# Q-09: real SMS/WhatsApp adapters remain disabled. Console mode simulates
# delivery in development/test without logging or exposing OTPs.
OTP_DELIVERY_MODE=disabled
# Set OTP_HMAC_PEPPER locally to a cryptographically random secret (>=32 chars).
OTP_DEVICE_SENDS_PER_HOUR=5
OTP_LOCKOUT_BASE_SECONDS=30
OTP_LOCKOUT_MAX_SECONDS=3600
# Development defaults to ~/.local/share/supplybiz/uploads; production requires an explicit root.
# UPLOAD_ROOT=/absolute/persistent/private/supplybiz-uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_PIXELS=20000000
HEALTHCHECK_STRICT=true

# T-150: set a persistent random 32-byte AES key encoded as 64 hex characters.
# ADMIN_TOTP_KEY=
# Missing key disables admin login; preserve it securely across API restarts.
